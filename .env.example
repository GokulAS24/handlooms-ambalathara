# Postgres connection string via Supabase's Supavisor pooler (Transaction mode).
# Supabase dashboard -> Connect -> Direct Connection -> Transaction pooler.
# Vercel's build/serverless network is IPv4-only, and Supabase's *direct*
# connection host is IPv6-only, so the pooler is required, not optional.
# Any special characters in the password (e.g. @) must be percent-encoded.
# connection_limit/pool_timeout are tuned up from Prisma's CPU-based default
# (as low as 3 on constrained build containers), which is too small for the
# handful of concurrent queries the homepage fires during static generation.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=8&pool_timeout=20"

# `prisma db push`/`migrate` can hang indefinitely through the transaction
# pooler above (PgBouncer transaction mode doesn't handle DDL well). Run
# schema changes with the direct connection instead, e.g.:
#   DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres" npx prisma db push
# (only viable from a normal IPv6-capable network — see the note below.)

# Random secret used by NextAuth to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Supabase project URL and service_role key, used server-side only for
# uploading product/banner images to Supabase Storage. Project Settings -> API.
# NEVER prefix these with NEXT_PUBLIC_ or expose them to the browser.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Used only by `npm run db:seed` to create/update the first admin login.
# Set a strong, unique password before seeding a production database.
ADMIN_EMAIL="admin@ambalatharahandlooms.in"
ADMIN_PASSWORD=""
